{
  "manifest_version": 3,
  "name": "Product Finder Companion",
  "version": "0.6.0",
  "description": "Persistent eBay sourcing companion with automatic product research, landed-cost economics, and wholesale list analysis.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel"],
  "host_permissions": [
    "https://*.ebay.com/*",
    "https://ebay.com/*",
    "https://*.ebay.ca/*",
    "https://ebay.ca/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "Product Finder" },
  "side_panel": { "default_path": "popup.html" },
  "options_page": "options.html",
  "content_scripts": [
    { "matches": ["https://*.ebay.com/*", "https://ebay.com/*", "https://*.ebay.ca/*", "https://ebay.ca/*"], "js": ["content.js"], "run_at": "document_idle" },
    { "matches": ["https://*.ebay.com/*", "https://ebay.com/*", "https://*.ebay.ca/*", "https://ebay.ca/*"], "js": ["ebay-product-research.js", "ebay-controller.js"], "run_at": "document_idle" }
  ]
}